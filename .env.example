# Posterium — esempio configurazione env (copia in .env.local)
# Vedi README.md "Variabili d'Ambiente" per dettagli completi.

# === Chiavi API (per-request: header x-api-key o query api_key; profilo ?u=) ===
# Fallback d'istanza opt-in per deploy personali single-user (NON usare su istanze pubbliche multi-utente):
# POSTERIUM_TMDB_KEY=your_tmdb_v3_key
# POSTERIUM_MDBLIST_KEY=your_mdblist_key
# POSTERIUM_TVDB_API_KEY=your_tvdb_key

# === Storage ===
# KV_REST_API_URL=https://xxx.upstash.io
# KV_REST_API_TOKEN=xxx
# POSTERIUM_DATA_DIR=/data

# === Render pipeline ===
# POSTERIUM_MAX_CONCURRENT_RENDERS=4
# POSTERIUM_RENDER_SLOT_WAIT_MS=15000
# POSTERIUM_RENDER_TIMEOUT_MS=30000
# POSTERIUM_CACHE_MAX_MB=150
# POSTERIUM_CACHE_MAX_ENTRIES=2000

# === Auth & rate limit ===
# POSTERIUM_ADMIN_TOKEN=supersegreto
# POSTERIUM_ALLOW_DEV_ADMIN=1   # solo in dev: apre admin ovunque (default: solo loopback)
# POSTERIUM_WARMUP_TOKEN=warmup-segreto  # obbligatorio se POSTERIUM_PUBLIC_INSTANCE=1
# POSTERIUM_RATELIMIT_POSTER_MAX=200
# POSTERIUM_LOG_LEVEL=info
# POSTERIUM_LOG_FORMAT=human
# POSTERIUM_TRUST_PROXY=1
# POSTERIUM_ALLOWED_HOSTS=example.com

# === Warmup & build ===
# POSTERIUM_SELF_WARMUP=1
# POSTERIUM_PUBLIC_INSTANCE=1
# NODE_MAX_OLD_SPACE=384
